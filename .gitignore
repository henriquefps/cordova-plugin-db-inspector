# ---------------------------------------------------------------------------
# Local test data — real app databases can contain customer / personal data.
# Never commit them. Use scripts/ to push them into the sample app instead.
# ---------------------------------------------------------------------------
test-data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Dependencies
node_modules/

# npm pack output
*.tgz

# Sample app: native projects are generated by `npx cap add android|ios`
sample-app/android/
sample-app/ios/
sample-app/dist/

# Android / Gradle leftovers (if a platform is ever generated in-tree)
local.properties
.gradle/
build/
*.apk
*.aab

# Xcode leftovers
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.ipa
*.dSYM.zip
*.dSYM

# Python (dev/server.py)
__pycache__/
*.py[cod]
.venv/
venv/

# Tooling output (browser automation screenshots, logs)
.playwright-mcp/
*.log

# Web inspector build output (Cloudflare Pages) and local wrangler state
site/
.wrangler/
# Local secrets for `wrangler pages dev` — never commit
.dev.vars*
.env
.env.*

# Claude Code worktrees
.claude/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
Thumbs.db
